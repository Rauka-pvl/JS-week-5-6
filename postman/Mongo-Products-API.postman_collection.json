    {
      "name": "1. Основные тесты (порядок из задания)",
      "item": [
        {
          "name": "01. POST /products — создание",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acer Aspire Laptop\",\n  \"price\": 310000,\n  \"category\": \"computer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "const product = pm.response.json().data;",
                  "pm.test('Есть _id', () => pm.expect(product).to.have.property('_id'));",
                  "pm.collectionVariables.set('productId', product._id);"
                ]
              }
            }
          ]
        },
